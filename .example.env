# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pass
POSTGRES_DB=mymoneydb

# Database Connection URL
DATABASE_URL=postgresql://postgres:your_pass@db:5432/mymoneydb

# JWT Configuration
JWT_SECRET=your_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — через запятую, если несколько
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SMTP Configuration
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yandex.ru
SMTP_TLS=true

# NEXT URLS
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# Redis (BullMQ background jobs). Compose points the backend at the `redis`
# service; the backend falls back to localhost when these are unset.
REDIS_HOST=redis
REDIS_PORT=6379

# Number of nightly pg_dump files to keep in ./backups
BACKUP_KEEP=14