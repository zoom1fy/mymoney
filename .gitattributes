# Shell scripts must stay LF (CRLF breaks exec in Linux containers)
*.sh text eol=lf

# Force LF for Windows dev, keep as-is for portable scripts
*.mjs text eol=lf
*.mts text eol=lf

# SQL migrations are embedded via include_str! and checksummed by sqlx;
# CRLF checkout on Windows would silently change the checksum and crash startup
*.sql text eol=lf

# Text files
*.ts text
*.tsx text
*.js text
*.json text
*.yml text
*.yaml text
*.md text
