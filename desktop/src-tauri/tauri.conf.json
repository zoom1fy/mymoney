{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyMoney",
  "version": "0.1.0",
  "identifier": "app.mymoney.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:fe",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build:fe",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "MyMoney",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
