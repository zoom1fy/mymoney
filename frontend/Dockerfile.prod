FROM oven/bun:1-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_COOKIE_DOMAIN

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_COOKIE_DOMAIN=$NEXT_PUBLIC_COOKIE_DOMAIN

COPY package.json bun.lock ./
# Shared with the runner stage below: its `--omit=dev` install then resolves
# from these tarballs instead of downloading the whole tree a second time.
RUN --mount=type=cache,id=bun-frontend,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY . .
RUN bun run build

FROM oven/bun:1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_COOKIE_DOMAIN=$NEXT_PUBLIC_COOKIE_DOMAIN

COPY --from=builder /app/package.json /app/bun.lock ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next

# Production-only dependencies (no dev tooling)
RUN --mount=type=cache,id=bun-frontend,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --omit=dev

EXPOSE 3000
CMD ["bun", "run", "start"]